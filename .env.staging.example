# =============================================================================
# STAGING ENVIRONMENT CONFIGURATION (LOCAL SAFE TESTING ONLY)
# Copy this file to `.env.staging` and fill in ONLY your isolated TEST values.
# NEVER use production URLs, production tokens, or production spreadsheets here.
# =============================================================================

APP_ENV="staging"
NODE_ENV="staging"
PORT="3000"
FRONTEND_ORIGIN="http://localhost:3000"

# Frontend Vite Configuration (Local Staging Backend - never points to Cloud Run)
VITE_APP_ENV="staging"
VITE_BACKEND_API_URL="http://localhost:3000"

# Google Apps Script TEST Webhook & Token (Required in Staging)
# Must point to the TEST Apps Script deployment linked to the TEST Google Sheet.
APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/REPLACE_WITH_TEST_APPS_SCRIPT_DEPLOYMENT_ID/exec"
APPS_SCRIPT_TOKEN="REPLACE_WITH_EXISTING_STAGING_TOKEN"

# Optional Staging Metadata / Overrides
STAGING_TEST_SPREADSHEET_ID="REPLACE_WITH_TEST_SPREADSHEET_ID"
STAGING_NOTIFICATION_RECIPIENT="REPLACE_WITH_TEST_RECIPIENT_EMAIL"
