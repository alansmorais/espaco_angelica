# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP BUSINESS CLOUD API (Meta Graph API)
# WHATSAPP_API_TOKEN: Permanent access token or System User token from Meta Business Manager with whatsapp_business_messaging permission.
WHATSAPP_API_TOKEN="MY_WHATSAPP_API_TOKEN"

# WHATSAPP_PHONE_NUMBER_ID: Phone Number ID generated in Meta App Dashboard > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"

# WHATSAPP_BUSINESS_ACCOUNT_ID: WhatsApp Business Account ID (WABA ID - optional).
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# WHATSAPP_API_VERSION: Meta Graph API version (default: v20.0).
WHATSAPP_API_VERSION="v20.0"

# GOOGLE APPS SCRIPT SECURE BACKEND NOTIFICATION (Server-Side Proxy)
# APPS_SCRIPT_WEBHOOK_URL: Webhook publicado sob a conta kontakt@alansmsolutions.com
APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbysNBMLthA_GvAZJR1irBGcS-3Lspbfz0NIsvz0P2ax6jzE4M01RwVJ0za6zFsq8bGojw/exec"

# APPS_SCRIPT_TOKEN: Chave/Token secreta de autorização exigida pelo doPost(e) do script.
# Mantida estritamente no servidor backend. NUNCA exposta em código público frontend ou GitHub.
APPS_SCRIPT_TOKEN=""

# CORS & SERVER CONFIGURATION (Render / Node.js Backend)
# FRONTEND_ORIGIN: URL oficial do frontend no GitHub Pages (ou domínio personalizado)
FRONTEND_ORIGIN="https://alanp.github.io"

# PORT: Porta do servidor Node (injetada automaticamente pelo Render em produção)
PORT="3000"

# FRONTEND VITE CONFIGURATION (GitHub Pages / Client App)
# VITE_BACKEND_API_URL: URL do backend seguro no Google Cloud Run
VITE_BACKEND_API_URL="https://espaco-angelica-backend-770203144889.southamerica-east1.run.app"
