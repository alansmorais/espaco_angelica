# Site data and booking persistence are handled by Google Apps Script + Google Sheets.
# The Apps Script URL is already configured in src/services/emailNotificationService.ts.
# Do not put APPS_SCRIPT_TOKEN or ADMIN_PASSWORD in this file or in frontend build variables.
#
# Configure these secrets in Google Apps Script > Project Settings > Script Properties:
# APPS_SCRIPT_TOKEN
# ADMIN_PASSWORD
# WHATSAPP_API_TOKEN (optional, Meta WhatsApp Cloud API)
# WHATSAPP_PHONE_NUMBER_ID (optional, Meta WhatsApp Cloud API)
# WHATSAPP_BUSINESS_ACCOUNT_ID (optional)
# WHATSAPP_API_VERSION (optional, defaults to v20.0)
